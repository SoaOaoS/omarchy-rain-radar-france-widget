#!/bin/bash
# Stands in for curl during check-panel.sh's integration run: no real network
# access. The radar index answers with no frames, so DataService never
# downloads or converts anything; the test injects its own scans instead.
case "${@: -1}" in
  *api.rainviewer.com/public/weather-maps.json)
    printf '{"radar":{"past":[],"nowcast":[]}}\n'
    ;;
  *)
    exit 1
    ;;
esac
